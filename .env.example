# Add this in Vercel Project Settings -> Environment Variables.
# The app runs with mock data when this is not set.
PANDASCORE_API_KEY=your_pandascore_token_here

# Optional production persistence for match comments.
# Use this on Vercel with Supabase, Neon, or another hosted Postgres database.
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
SECRET_KEY=replace_with_a_long_random_secret

# Optional tuning
SCORES_PAGE_SIZE=40
SCORES_API_TIMEOUT=8
FORUM_STORAGE_FILE=./data/forum_threads.json

# Optional GRID support for CS/Dota detailed stats.
# GRID account schemas can differ, so provide the match detail endpoint template you receive from GRID.
GRID_API_KEY=your_grid_key_here
GRID_MATCH_DETAIL_URL_TEMPLATE=https://example.grid.endpoint/matches/{match_id}
GRID_API_TIMEOUT=8

# Optional Cito support for player-stat enrichment.
# Default auth header is x-api-key. Set CITO_AUTH_HEADER=Authorization for bearer-style demo keys.
CITO_API_KEY=your_cito_key_here
CITO_BASE_URL=https://api.citoapi.com/api/v1
CITO_MATCH_STATS_URL_TEMPLATE=https://api.citoapi.com/api/v1/{game}/matches/{match_id}/player-stats
CITO_AUTH_HEADER=x-api-key
CITO_API_TIMEOUT=8
